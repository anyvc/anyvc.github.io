---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import RedactionList from '../../components/site/RedactionList.astro';
import Withheld from '../../components/site/Withheld.astro';
import CaseHeader from '../../components/case/CaseHeader.astro';
import KpiStrip from '../../components/case/KpiStrip.astro';
import Toc from '../../components/case/Toc.astro';
import CaseSection from '../../components/case/CaseSection.astro';
import CaseFlow from '../../components/case/CaseFlow.astro';
import CaseArtifact from '../../components/case/CaseArtifact.astro';
import CaseDocs from '../../components/case/CaseDocs.astro';
import PrevNext from '../../components/case/PrevNext.astro';
import { getCases, SECTIONS } from '../../lib/cases';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: cases[i - 1] ?? null, next: cases[i + 1] ?? null },
  }));
}
const { entry, prev, next } = Astro.props;
const c = entry.data;
const secs = SECTIONS.filter(([k]) => c.sections[k]?.length);
const toc = [...secs.map(([k, t]) => ({ id: `sec-${k}`, t })), ...(c.docs.length ? [{ id: 'sec-docs', t: 'Documents' }] : [])];
---
<Base title={`${c.title} – ${site.name}`} description={c.summary} home={false}>
  <div class="case-page">
    <div class="cf-main">
      <CaseHeader entry={entry} />
      <KpiStrip kpis={c.kpis} />
      <div class="cf-grid">
        <aside class="cf-side"><Toc items={toc} /></aside>
        <article class="cf-body">
          {secs.map(([k, t], idx) => (
            <CaseSection id={k} title={t} paras={c.sections[k]} first={idx === 0}>
              {k === 'setup' && c.redactions && (
                <p class="cf-kv">Redacted on purpose: <RedactionList items={c.redactions} /></p>
              )}
              {k === 'did' && c.diagram && <CaseFlow diagram={c.diagram} />}
              {k === 'results' && c.artifact && <CaseArtifact artifact={c.artifact} signal={c.signal} />}
            </CaseSection>
          ))}
          {c.docs.length > 0 && <CaseDocs docs={c.docs} />}
          <p class="cf-kv withheld-end"><Withheld /></p>
        </article>
      </div>
      <PrevNext prev={prev} next={next} />
    </div>
  </div>
</Base>

<style>
  .case-page {
    min-height: calc(100svh - 80px);
  }
  :global(html[data-mode='watcher']) .case-page {
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, .22) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at 85% 0, #2a0000 0, #0b0303 42%, #060303 75%);
  }
  .cf-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 36px 24px 80px;
  }
  @media (min-width: 860px) {
    .cf-main { padding: 40px 6vw 80px; }
  }
  .cf-grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .cf-side {
    position: sticky;
    top: 96px;
  }
  .cf-body { min-width: 0; }
  .cf-kv {
    font: 400 13px/1.6 var(--font-mono);
    color: var(--color-muted);
    margin: 0 0 8px;
  }
  .withheld-end { margin-top: 12px; }

  @media (max-width: 860px) {
    .cf-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .cf-side { position: static; }
  }
</style>
