---
// STAGE 2 PREVIEW ONLY: proves tokens, fonts and the mode toggle. Stage 3 replaces this with the real hero and highlights.
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base>
  <div class="w-wrap preview">
    <p class="w-chip">Stage 2 preview</p>
    <h1>{site.hero.headline}</h1>
    <p>{site.hero.sub}</p>
    <div class="w-card">
      <p class="w-num">3.4×</p>
      <h3>Sample card</h3>
      <p>Border, top border, radius and background all come from the active mode's tokens. <a href="#main">Sample link</a></p>
      <p>Redaction sample: <span class="w-redact" role="img" aria-label="redacted" style="width:8ch"></span></p>
    </div>
  </div>
</Base>
<style>.preview { padding-block: 3rem 5rem; }</style>
