---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Highlights from '../components/home/Highlights.astro';
import CaseGrid from '../components/home/CaseGrid.astro';
import Coverage from '../components/home/Coverage.astro';
import About from '../components/home/About.astro';
import Experience from '../components/home/Experience.astro';
import Gallery from '../components/home/Gallery.astro';
import Contact from '../components/home/Contact.astro';
---
<Base home={true}>
  <Hero />
  <Marquee variant="top" />
  <Highlights />
  <CaseGrid />
  <Coverage />
  <About />
  <Experience />
  <Gallery />
  <Marquee variant="bottom" />
  <Contact />
</Base>
