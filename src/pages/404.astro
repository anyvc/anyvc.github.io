---
import Base from "../layouts/Base.astro";
import profile from "../data/profile.json";

const description = `No page exists at this address on ${profile.name}'s site.`;
---

<Base title="Page not found" description={description} noindex>
  <section class="not-found" aria-labelledby="not-found-heading">
    <h1 id="not-found-heading">Page not found</h1>
    <p class="lede">There is no page at this address. It may have moved or never existed.</p>
    <p class="home-link"><a href="/">Go to the home page</a></p>
  </section>
</Base>

<style>
  .not-found {
    padding-block: var(--space-9) var(--space-8);
  }

  .lede {
    margin-top: var(--space-4);
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .home-link {
    margin-top: var(--space-5);
  }
</style>
