---
import { existsSync } from "node:fs";
import Base from "../layouts/Base.astro";
import profile from "../data/profile.json";

/* Only fields from src/data/profile.json are shown here. Nothing is invented. */
const emailIsTodo = profile.links.email.startsWith("TODO");
const cvAvailable = existsSync(new URL("../../public/cv.pdf", import.meta.url));
const description = `CV for ${profile.name}. ${profile.roleLine}`;
---

<Base title="CV" description={description}>
  <article class="cv" aria-labelledby="cv-name">
    <header class="cv-head rule-dither">
      <h1 id="cv-name">{profile.name}</h1>
      <p class="cv-role">{profile.roleLine}</p>
      <p class="cv-status">{profile.status}</p>
      <button class="print-button" type="button" data-print>Print this page</button>
    </header>

    <section class="cv-section rule-dither" aria-labelledby="cv-links-heading">
      <h2 id="cv-links-heading">Links</h2>
      <ul class="cv-links">
        {
          !emailIsTodo && (
            <li>
              <a href={`mailto:${profile.links.email}`}>{profile.links.email}</a>
            </li>
          )
        }
        <li><a href={profile.links.github}>GitHub</a></li>
        <li><a href={profile.links.linkedin}>LinkedIn</a></li>
      </ul>

      {
        emailIsTodo && (
          <p class="todo">
            TODO: add a public contact email to <code>src/data/profile.json</code>. It is left
            off this page until it exists.
          </p>
        )
      }
    </section>

    <section class="cv-section rule-dither" aria-labelledby="cv-file-heading">
      <h2 id="cv-file-heading">CV file</h2>
      {
        cvAvailable ? (
          <p><a href={profile.cv}>Download the CV as a PDF</a></p>
        ) : (
          <p class="todo">
            TODO: add <code>public/cv.pdf</code>. This link appears once the file exists.
          </p>
        )
      }
    </section>

    <p class="cv-note">
      This page prints without the site navigation. Use the button above or your browser's print
      command.
    </p>
  </article>
</Base>

<script>
  const printButton = document.querySelector<HTMLButtonElement>("[data-print]");
  printButton?.addEventListener("click", () => window.print());
</script>

<style>
  .cv {
    max-width: var(--measure);
    padding-block: var(--space-8);
  }

  .cv-head {
    padding-bottom: var(--space-5);
  }

  .cv-role {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    max-width: var(--measure);
  }

  .cv-status {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  .print-button {
    margin-top: var(--space-5);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1;
    cursor: pointer;
  }

  .print-button:hover {
    border-color: var(--text);
  }

  .cv-section {
    padding-block: var(--space-6);
  }

  .cv-section h2 {
    margin-bottom: var(--space-3);
  }

  .cv-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .cv-note {
    margin-top: var(--space-5);
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }

  @media print {
    :global(.site-header),
    :global(.skip-link),
    .print-button,
    .cv-note {
      display: none;
    }

    .cv {
      max-width: none;
      padding-block: 0;
    }

    /* Printed links keep their full address even when the label is short.
       Mail links already print the address, so they are left alone. */
    .cv-links a:not([href^="mailto:"])::after {
      content: " (" attr(href) ")";
      font-size: var(--text-xs);
    }
  }
</style>
