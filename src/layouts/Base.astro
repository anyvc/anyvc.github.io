---
import '../styles/fonts.css';
import '../styles/base.css';
import TokenStyles from '../components/TokenStyles.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import site from '../data/site.json';
const { title = site.title, description = site.description, home = true } = Astro.props;
const url = new URL(Astro.url.pathname, site.siteUrl).href;
const og = new URL(site.ogImage, site.siteUrl).href;
---
<!doctype html>
<html lang="en" data-mode="watcher" data-fx="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <TokenStyles />
    <script is:inline>
      // Runs before first paint. Order: stored choice, then reduced motion -> Clean, else Watcher.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var m = null;
        try { m = localStorage.getItem('watcher-mode'); } catch (e) {}
        if (m !== 'watcher' && m !== 'clean') {
          m = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches ? 'clean' : 'watcher';
        }
        d.dataset.mode = m;
      })();
    </script>
  </head>
  <body>
    <a class="w-skip" href="#main">Skip to content</a>
    <Nav home={home} />
    <main id="main"><slot /></main>
    <Footer />
    <script>import '../scripts/mode';</script>
  </body>
</html>
