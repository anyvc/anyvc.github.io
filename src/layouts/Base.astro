---
import '../styles/fonts.css';
import '../styles/base.css';
import TokenStyles from '../components/TokenStyles.astro';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import site from '../data/site.json';
const { title = site.title, description = site.description, home = true, noindex = false } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const url = new URL(path, site.siteUrl).href; // GitHub Pages serves directories with a trailing slash
// Preload the two fonts the default (Watcher) first paint needs. If the glob finds nothing, no preload is emitted and nothing breaks.
const fontFiles = import.meta.glob('../../node_modules/@fontsource/{unbounded/files/unbounded-latin-900-normal.woff2,newsreader/files/newsreader-latin-400-normal.woff2}', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
const preloads = Object.values(fontFiles);
const person = { '@context': 'https://schema.org', '@type': 'Person', name: site.name, url: site.siteUrl, description: site.description,
  sameAs: site.contact.links.filter(l => l.href.startsWith('https://')).map(l => l.href) };
const og = new URL(site.ogImage, site.siteUrl).href;
---
<!doctype html>
<html lang="en" data-mode="watcher" data-fx="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    {preloads.map(h => <link rel="preload" as="font" type="font/woff2" href={h} crossorigin />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />
    {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <TokenStyles />
    <script is:inline>
      // Runs before first paint. Order: stored choice, then reduced motion -> Clean, else Watcher.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var m = null;
        try { m = localStorage.getItem('watcher-mode'); } catch (e) {}
        if (m !== 'watcher' && m !== 'clean') {
          m = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches ? 'clean' : 'watcher';
        }
        d.dataset.mode = m;
        // Effects tier. Lite = no grain, scanlines, glitch or marquee motion (eyes and coverage stay).
        var lite = false;
        try {
          var n = navigator, c = n.connection || {}, mm = function (q) { return window.matchMedia && matchMedia(q).matches; };
          lite = mm('(pointer: coarse)') || mm('(prefers-reduced-motion: reduce)') ||
            (n.hardwareConcurrency && n.hardwareConcurrency <= 4) || (n.deviceMemory && n.deviceMemory <= 4) || !!c.saveData;
        } catch (e) {}
        d.dataset.fx = lite ? 'lite' : 'full';
      })();
    </script>
  </head>
  <body>
    <div class="w-fx w-grain" aria-hidden="true"></div><div class="w-fx w-scan" aria-hidden="true"></div>
    <a class="w-skip" href="#main">Skip to content</a>
    <Nav home={home} />
    <main id="main"><slot /></main>
    <Footer />
    <script>import '../scripts/mode'; import '../scripts/eyes'; import '../scripts/reticle'; import '../scripts/nav';</script>
  </body>
</html>
