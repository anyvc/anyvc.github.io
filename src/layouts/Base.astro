---
import "../styles/tokens.css";
import "../styles/fonts.css";
import profile from "../data/profile.json";

interface Props {
  /** Short page title; the site name is appended unless this is the home page. */
  title: string;
  description: string;
  /** Keeps the page out of search results and drops its canonical URL. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageTitle = title === profile.name ? title : `${title} — ${profile.name}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          document.documentElement.dataset.theme =
            localStorage.getItem("theme") === "clean" ? "clean" : "watch";
        } catch {
          document.documentElement.dataset.theme = "watch";
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header rule-dither">
      <a class="site-name" href="/">{profile.name}</a>
      <nav aria-label="Sections">
        <ul>
          <li><a href="#case-files">Case files</a></li>
          <li><a href="#coverage">Coverage</a></li>
          <li><a href="#writing">Writing</a></li>
          <li><a href="/cv">CV</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
      <button class="clean-toggle" type="button" aria-pressed="false" data-clean-toggle>
        <span class="clean-toggle-mark" aria-hidden="true"></span>
        <span>Clean view</span>
      </button>
    </header>

    <main id="main">
      <slot />
    </main>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-clean-toggle]");

      if (toggle) {
        const root = document.documentElement;

        const sync = () => {
          toggle.setAttribute("aria-pressed", String(root.dataset.theme === "clean"));
        };

        sync();

        toggle.addEventListener("click", () => {
          const next = root.dataset.theme === "clean" ? "watch" : "clean";
          root.dataset.theme = next;
          sync();

          try {
            localStorage.setItem("theme", next);
          } catch {
            // Storage can be blocked; the current page still switches.
          }
        });
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-text);
    font-size: var(--text-base);
    line-height: var(--leading-text);
    -webkit-text-size-adjust: 100%;
  }

  /* No effects yet: plain scrolling, no smooth-scroll animation. */
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin: 0;
    text-wrap: balance;
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 600;
  }

  h3 {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  p,
  ul,
  ol,
  dl,
  dd,
  figure {
    margin: 0;
  }

  ul,
  ol {
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--divider);
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: var(--text);
  }

  :focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--selection);
    color: var(--text);
  }

  code,
  .mono {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .todo {
    color: var(--text-muted);
    border: 1px dashed var(--divider);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    max-width: var(--measure);
  }

  .site-header {
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-5);
  }

  /* The one section edge, reused on the header and every section.
     The pattern and colour are tokens; clean view and print swap in a
     plain 1px rule through the same custom properties. */
  .rule-dither {
    position: relative;
    border-bottom: 0;
  }

  .rule-dither::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: var(--dither-height);
    background-color: var(--dither-color);
    opacity: var(--dither-opacity);
    -webkit-mask-image: var(--dither-mask);
    mask-image: var(--dither-mask);
    -webkit-mask-size: var(--dither-mask-size);
    mask-size: var(--dither-mask-size);
    -webkit-mask-repeat: repeat;
    mask-repeat: repeat;
    pointer-events: none;
  }

  .site-name {
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .site-header nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .site-header nav a {
    color: var(--text-muted);
  }

  .site-header nav a:hover {
    color: var(--text);
  }

  .clean-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1;
    cursor: pointer;
  }

  .clean-toggle:hover {
    color: var(--text);
    border-color: var(--text);
  }

  /* Visible state marker: empty outline when off, solid fill when on.
     aria-pressed carries the same state to assistive technology. */
  .clean-toggle-mark {
    display: inline-block;
    flex: none;
    width: 0.75em;
    height: 0.75em;
    border: 1px solid currentColor;
    border-radius: 1px;
  }

  .clean-toggle[aria-pressed="true"],
  :root[data-theme="clean"] .clean-toggle {
    color: var(--text);
    border-color: var(--blood);
    background: var(--surface);
  }

  .clean-toggle[aria-pressed="true"] .clean-toggle-mark,
  :root[data-theme="clean"] .clean-toggle .clean-toggle-mark {
    background: var(--text);
  }

  main {
    flex: 1;
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: calc(-1 * var(--space-10));
    z-index: 1;
    background: var(--surface);
    padding: var(--space-2) var(--space-4);
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  @media (max-width: 30rem) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .clean-toggle {
      margin-inline-start: 0;
    }
  }
</style>
