---
import RedactionList from '../site/RedactionList.astro';
import { fmtTid } from '../../lib/format';
const { cases } = Astro.props;
---
{cases.map((e: any, i: number) => {
  const c = e.data;
  const code = `CASE-${String(i + 1).padStart(2, '0')} // ${e.id.toUpperCase().replace(/-LAB$/, '')}`;
  const takeaway = c.sections.results?.[c.sections.results.length - 1] ?? c.summary;
  const note =
    e.id === 'ruledetonate'
      ? (c.sections.failed?.[0] ?? c.sections.next?.[0] ?? '')
      : (c.sections.next?.[0] ?? c.sections.failed?.[0] ?? '');
  const externalDocs = (c.docs ?? []).filter((d: { href: string | null }) => !!d.href);
  const diagram = c.diagram;
  const nodes = diagram?.nodes ?? [];
  const edges = diagram?.edges ?? [];
  const hot = diagram?.hot ?? -1;
  return (
    <template data-preview={e.id} data-title={c.title}>
      <div class="dpi">
        <div class="dpb">
          <div class="dh">
            <span>{code}<span class="stamp">CLASSIFIED</span></span>
            <button type="button" class="dx" data-x aria-label="Close case file">✕</button>
          </div>
          <div class="dg2">
            <div class="dcl">
              <div class="dk">Summary</div>
              <p class="ds">{c.summary}</p>
              <p class="dp-meta">{c.meta}{c.credit && <> · {c.credit}</>}</p>
              <p class="dp-tags">{c.tags.map((t: string) => <span>{t}</span>)}</p>
              {c.redactions && (
                <p class="dp-rd">Withheld on purpose: <RedactionList items={c.redactions} /></p>
              )}
              <div class="dk">Key takeaway</div>
              <div class="ko">
                <p set:html={fmtTid(takeaway)} />
                {note && (
                  <p><b>Detection &amp; mitigation note</b><span set:html={fmtTid(note)} /></p>
                )}
              </div>
            </div>

            <div class="dcr">
              <div class="dk">Proof of work</div>
              <div class="dl">
                <a class="dbtn" href={`/case/${e.id}/`}>Read full case file →</a>
                {externalDocs.map((d: { label: string; href: string }) => (
                  <a class="dbtn pv" href={d.href} target="_blank" rel="noopener">{d.label} ↗</a>
                ))}
                {e.id === 'wazuh-soc-lab' && (
                  <a class="dbtn pv" href="#coverage" data-x>Jump to coverage</a>
                )}
              </div>

              <div class="dk">{diagram?.label ?? 'Architecture'}</div>
              <div class="dia">
                {nodes.length > 0 ? (
                  <div class="diagram-box">
                    <ol class="topo" aria-label={nodes.map((n: { title: string }) => n.title).join(' → ')}>
                      {nodes.map((n: { title: string; sub?: string }, idx: number) => (
                        <li class:list={['nd', { 'is-hot': idx === hot }]}>
                          <span class="sg">STAGE {String(idx + 1).padStart(2, '0')}</span>
                          <b>{n.title}</b>
                          {n.sub && <small>{n.sub}</small>}
                          {idx < nodes.length - 1 && (
                            <span class="lk" aria-hidden="true">
                              {edges[idx] && <i>{edges[idx]}</i>}
                            </span>
                          )}
                        </li>
                      ))}
                    </ol>
                  </div>
                ) : (
                  <div class="ph">[ diagram pending ] topology or flow for this case file</div>
                )}
                {c.card.caption && <p class="dcap" set:html={fmtTid(c.card.caption)} />}
              </div>

              <div class="dk">Detection artifact</div>
              <div class="cd">
                {c.artifact ? (
                  <>
                    <div class="ct">
                      <span>{c.artifact.type}</span>
                      <button type="button" data-copy>Copy</button>
                    </div>
                    <pre><code>{c.artifact.code}</code></pre>
                  </>
                ) : (
                  <div class="ph">[ artifact pending ] rule, query or sanitized log</div>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </template>
  );
})}

<style is:global>
  /* Inline expandable dossier drawer (#dp) */
  .dp {
    grid-column: 1 / -1;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .35s cubic-bezier(.2, .7, .2, 1);
  }
  .dp.on { grid-template-rows: 1fr; }
  .dpi { min-height: 0; overflow: hidden; }
  .dpb {
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    background: #0a0404;
    padding: 20px 26px 26px;
    margin-top: 2px;
  }
  .dh {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font: 400 .72rem var(--font-mono);
    color: var(--color-danger);
    letter-spacing: .1em;
  }
  .dx {
    font: 400 1rem var(--font-mono);
    background: none;
    color: var(--color-text);
    border: 1px solid var(--color-accent);
    width: 38px;
    height: 38px;
    cursor: pointer;
    flex: none;
  }
  .dx:hover { background: var(--color-accent); color: #fff; }
  .stamp {
    display: inline-block;
    font: 400 .68rem var(--font-mono);
    letter-spacing: .14em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 2px 8px;
    transform: rotate(-2deg);
    margin-left: 8px;
  }
  .dg2 { display: grid; grid-template-columns: 1fr; gap: 0 36px; }
  .dcl, .dcr { min-width: 0; }
  @media (min-width: 860px) {
    .dg2 { grid-template-columns: minmax(0, 1fr) minmax(360px, 560px); align-items: start; }
  }
  .dk {
    font: 400 .72rem var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-danger);
    margin: 26px 0 8px;
  }
  .dk::before { content: '// '; }
  .ds { margin: 0 0 6px; color: var(--color-muted); max-width: none; }
  .dp-meta { font: 400 .85rem var(--font-mono); color: var(--color-muted); margin: 0 0 10px; }
  .dp-tags { font: 400 .88rem var(--font-mono); color: var(--color-muted); margin: 0 0 10px; }
  .dp-tags span:not(:last-child)::after { content: ', '; }
  .dp-rd { font: 400 .85rem var(--font-mono); color: var(--color-muted); margin: 10px 0 0; }
  .ko {
    border: 1px solid var(--color-warn);
    border-left: 5px solid var(--color-warn);
    background: rgba(242, 165, 80, .07);
    padding: 14px 16px;
  }
  .ko p { margin: 0 0 10px; max-width: none; }
  .ko p:last-child { margin: 0; }
  .ko b {
    font: 400 .72rem var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-warn);
    display: block;
    margin-bottom: 2px;
  }
  .dl { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
  .dbtn {
    font: 600 .68rem var(--font-display);
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--color-accent);
    color: #fff;
    background: var(--color-accent);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }
  .dbtn:hover { background: #ff2a22; }
  .dbtn.pv { background: none; color: var(--color-text); }
  .dbtn.pv:hover { background: var(--color-accent); color: #fff; }

  /* Horizontal compact topology */
  .dia { border: 1px solid var(--color-line); background: rgba(20, 0, 0, .5); padding: 12px; }
  .dia .ph { display: grid; place-items: center; min-height: 150px; border: 1px dashed #555; font: 400 .78rem var(--font-mono); color: var(--color-muted); text-align: center; padding: 16px; }
  .diagram-box { container-type: inline-size; }
  .topo { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 34px 0; }
  .nd {
    position: relative;
    min-width: 0;
    padding: 9px 12px 11px;
    border: 1px solid var(--color-text);
    background: #0a0000;
    font: 400 .74rem/1.3 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .nd .sg { display: block; font-size: .58rem; letter-spacing: .14em; color: var(--color-danger); margin-bottom: 4px; }
  .nd b { display: block; font-weight: 600; }
  .nd small { display: block; margin-top: 2px; font-size: .62rem; color: var(--color-muted); }
  .nd.is-hot { border: 2px solid var(--color-accent); box-shadow: 0 0 0 1px rgba(225, 6, 0, .35), 4px 4px 0 var(--color-tint); }
  .lk { position: absolute; left: 50%; top: 100%; width: 0; height: 34px; border-left: 1px dashed var(--color-text); pointer-events: none; }
  .lk i {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    font: 400 .56rem var(--font-mono);
    letter-spacing: .04em;
    white-space: nowrap;
    color: var(--color-danger);
    background: #0a0404;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    padding: 1px 7px;
  }
  .dcap { margin: 10px 0 0; font: 400 .72rem/1.4 var(--font-mono); color: var(--color-muted); max-width: none; }
  .dcap::before { content: '> '; color: var(--color-accent); }
  @container (min-width: 420px) {
    .topo { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 34px 52px; }
    .nd:not(:nth-child(3n)) .lk { left: 100%; top: 50%; width: 52px; height: 0; border-left: 0; border-top: 1px dashed var(--color-text); }
    .nd:not(:nth-child(3n)) .lk i { left: 50%; top: 0; }
    .nd:nth-child(3n) .lk { height: 17px; }
    .nd:nth-child(3n) .lk::before { content: ''; position: absolute; top: 16px; right: 0; width: calc(2 * ((100cqw - 104px) / 3 + 52px)); border-top: 1px dashed var(--color-text); }
    .nd:nth-child(3n) .lk::after { content: ''; position: absolute; top: 16px; height: 18px; right: calc(2 * ((100cqw - 104px) / 3 + 52px)); border-left: 1px dashed var(--color-text); }
  }

  /* Detection artifact code block */
  .cd { border: 1px solid #2a1212; background: #050202; }
  .cd .ct {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-bottom: 1px solid #2a1212;
    font: 400 .7rem var(--font-mono);
    color: var(--color-muted);
  }
  .cd .ct button {
    font: 400 .7rem var(--font-mono);
    background: none;
    color: var(--color-text);
    border: 1px solid var(--color-accent);
    padding: 4px 10px;
    cursor: pointer;
  }
  .cd .ct button:hover { background: var(--color-accent); color: #fff; }
  .cd pre { margin: 0; padding: 12px; overflow-x: auto; font: 400 .78rem/1.55 var(--font-mono); color: #cfe8cf; tab-size: 2; }
  .cd .ph { padding: 18px 12px; font: 400 .78rem var(--font-mono); color: var(--color-muted); }

  /* Clean view overrides for drawer */
  html[data-mode='clean'] .dp { transition: none; }
  html[data-mode='clean'] .dpb {
    background: #fff;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-accent);
    border-radius: 8px;
  }
  html[data-mode='clean'] .dh { color: var(--color-muted); font-size: 12px; }
  html[data-mode='clean'] .stamp { display: none; }
  html[data-mode='clean'] .dx { color: var(--color-text); border-color: var(--color-line); background: #fff; border-radius: 50%; }
  html[data-mode='clean'] .dx:hover { background: #EFEDE6; color: var(--color-text); }
  html[data-mode='clean'] .dk { color: var(--color-accent); font-size: 12px; letter-spacing: .06em; }
  html[data-mode='clean'] .dp-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  html[data-mode='clean'] .dp-tags span { background: #e0f2fe; color: #075985; border-radius: 999px; padding: 2px 10px; font: 500 .74rem var(--font-body); }
  html[data-mode='clean'] .dp-tags span::after { content: none !important; }
  html[data-mode='clean'] .ko { background: #FBF3D5; border-color: #EBD98E; border-left-color: #C8A400; border-radius: 6px; }
  html[data-mode='clean'] .ko b { color: #B45309; }
  html[data-mode='clean'] .dbtn { background: #1C1B18; border-color: #1C1B18; color: #fff; border-radius: 8px; font: 600 .78rem var(--font-body); }
  html[data-mode='clean'] .dbtn:hover { background: var(--color-accent); border-color: var(--color-accent); }
  html[data-mode='clean'] .dbtn.pv { background: #fff; color: var(--color-text); border-color: var(--color-line); }
  html[data-mode='clean'] .dbtn.pv:hover { background: #EFEDE6; color: var(--color-text); }
  html[data-mode='clean'] .dia { background: #fff; border-color: var(--color-line); border-radius: 8px; }
  html[data-mode='clean'] .nd { background: #fff; border-color: #cbd5e1; border-radius: 8px; }
  html[data-mode='clean'] .nd .sg { color: var(--color-accent); }
  html[data-mode='clean'] .nd.is-hot { border-color: var(--color-danger); box-shadow: none; }
  html[data-mode='clean'] .lk,
  html[data-mode='clean'] .nd:nth-child(3n) .lk::before,
  html[data-mode='clean'] .nd:nth-child(3n) .lk::after { border-color: #94a3b8 !important; }
  html[data-mode='clean'] .lk i { background: #fff; border-color: var(--color-line); color: var(--color-muted); }
  html[data-mode='clean'] .cd { background: #f1f5f9; border-color: var(--color-line); border-radius: 8px; }
  html[data-mode='clean'] .cd .ct { border-color: var(--color-line); color: var(--color-muted); }
  html[data-mode='clean'] .cd .ct button { color: var(--color-text); border-color: #cbd5e1; background: #fff; border-radius: 999px; }
  html[data-mode='clean'] .cd pre { color: #0f172a; }
  @media (min-width: 860px) {
    html[data-mode='clean'] .dg2 { grid-template-columns: minmax(0, 1fr) minmax(360px, 480px); }
  }
  @media (prefers-reduced-motion: reduce) { .dp { transition: none; } }
</style>
