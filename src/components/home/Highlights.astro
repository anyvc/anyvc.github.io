---
import hl from '../../data/highlights.json';
---
<section class="hsec" id="highlights" aria-labelledby="hl-h">
  <div class="w-wrap">
    <h2 id="hl-h" class="w-sr">Highlights</h2>
    <div class="hl-g">
      {hl.items.map(i => (
        <div>
          <b>{i.n}</b>
          <span>{i.label}</span>
          {(i.small || i.link) && (
            <small>
              {i.small}
              {i.link && <a href={i.link.href} target="_blank" rel="noopener">{i.link.label}</a>}
            </small>
          )}
        </div>
      ))}
    </div>
    <p class="hl-n">{hl.caption}</p>
  </div>
</section>

<style>
  .hsec {
    padding: 64px 0 0;
    position: relative;
    z-index: 2;
  }
  .hl-g {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .hl-g > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 20px 18px;
    border: var(--shape-card-border);
    border-top: var(--shape-card-top);
    border-radius: var(--shape-radius);
    background: var(--shape-card-bg);
    color: var(--color-text);
  }
  .hl-g b {
    font: 900 1.8rem/1 var(--font-display);
    color: var(--color-text);
  }
  .hl-g span {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  .hl-g small {
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px dashed var(--color-line);
    font: 400 .72rem/1.4 var(--font-mono);
    color: var(--color-muted);
  }
  .hl-g a { color: inherit; }
  .hl-n {
    margin: 16px 0 0;
    font: 400 .8rem/1.5 var(--font-mono);
    color: var(--color-muted);
  }

  /* Clean view */
  :global(html[data-mode='clean']) .hsec { padding: 24px 0 0; }
  :global(html[data-mode='clean']) .hl-g { gap: 20px; }
  :global(html[data-mode='clean']) .hl-g > div {
    gap: 0;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 22px 22px 18px;
  }
  :global(html[data-mode='clean']) .hl-g b {
    font: 800 2.5rem/1 var(--font-display);
    letter-spacing: -.04em;
    color: var(--color-accent);
    margin: 10px 0 2px;
  }
  :global(html[data-mode='clean']) .hl-g span {
    font: 400 1rem/1.45 var(--font-body);
    color: var(--color-muted);
    margin-bottom: 12px;
  }
  :global(html[data-mode='clean']) .hl-g small {
    border-top: 1px solid var(--color-line);
    padding-top: 10px;
    font: 400 12px/1.4 var(--font-mono);
    color: var(--color-muted);
  }
  :global(html[data-mode='clean']) .hl-g a { color: var(--color-accent); }
  :global(html[data-mode='clean']) .hl-n {
    font: 400 12px/1.5 var(--font-mono);
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .hl-g { grid-template-columns: 1fr; }
  }
</style>
