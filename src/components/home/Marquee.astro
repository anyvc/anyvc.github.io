---
import site from '../../data/site.json';
const [a, b] = site.marquees;
const run = (t: string) => Array.from({ length: 8 }, () => t).join('   ');
---
<div class="marquees w-only-watcher w-noprint" aria-hidden="true">
  <div class="band one"><div class="track">{run(a)}   {run(a)}</div></div>
  <div class="band two"><div class="track rev">{run(b)}   {run(b)}</div></div>
</div>
<style>
  .marquees { overflow: hidden; padding-block: 1.5rem; }
  .band { overflow: hidden; white-space: nowrap; border-block: 1px solid var(--color-line); }
  .one { background: #000; transform: rotate(-1.2deg) scale(1.04); }
  .two { background: var(--color-tint); transform: rotate(1deg) scale(1.04); margin-top: -.4rem; }
  .track { display: inline-block; font-family: var(--font-display); font-weight: 900; line-height: 1.2; animation: scroll 40s linear infinite; }
  .one .track { font-size: clamp(2.2rem, 7vw, 5rem); color: transparent; -webkit-text-stroke: 1.5px var(--color-accent); }
  .two .track { font-size: clamp(1.5rem, 4vw, 2.8rem); color: #ff4a42; animation-direction: reverse; animation-duration: 48s; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  /* Motion off: reduced motion, coarse pointers, and the Lite variant (set in stage 7). */
  @media (prefers-reduced-motion: reduce), (pointer: coarse) { .track { animation: none; } }
  :global(html[data-fx='lite']) .track { animation: none; }
</style>
