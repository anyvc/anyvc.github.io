---
import site from '../../data/site.json';
import { heroEyeInner, heroLogRows } from '../../lib/eyeSvg';

const { hero, contact } = site;
const logs = heroLogRows();
const github = contact.links.find(l => l.label === 'GitHub');
const linkedin = contact.links.find(l => l.label === 'LinkedIn');
const email = contact.links.find(l => l.label === 'Email');
const cv = contact.links.find(l => l.label === 'CV');
const nameParts = site.name.split(' ');
---
<header class="hero" id="top">
  <!-- Watcher background layers -->
  <div class="logs w-only-watcher" aria-hidden="true">
    {logs.map(r => (
      <div
        class="lr"
        style={`animation-duration:${r.dur}s${r.rev ? ';animation-direction:reverse' : ''}`}
      >{r.text}</div>
    ))}
  </div>
  <svg id="heye" class="w-only-watcher" viewBox="-200 -200 400 400" aria-hidden="true" set:html={heroEyeInner()} />
  <div class="live w-only-watcher">{hero.liveLine}</div>

  <!-- Unified semantic hero container with strictly ONE <h1> -->
  <div class="hero-inner">
    <div class="hero-left">
      <p class="cl-badge w-only-clean"><i aria-hidden="true"></i>{hero.badge}</p>
      <h1 class="hero-h1">
        <span class="w-only-watcher w-name">{nameParts.map(p => <span>{p}</span>)}</span>
        <span class="w-only-clean cl-h1">{hero.headline}</span>
      </h1>
      <p class="lead w-only-watcher">{hero.headline}</p>
      <p class="sub">{hero.sub}</p>
      <p class="mono-line w-only-watcher">{hero.badge}</p>
      <p class="mono-line w-only-watcher">{hero.statusLine}</p>

      <p class="links w-only-watcher">
        {github && <a href={github.href} target="_blank" rel="noopener">{github.label}</a>}
        {linkedin && <a href={linkedin.href} target="_blank" rel="noopener">{linkedin.label}</a>}
        <a class="cta" href="#case">See what I’ve built</a>
        <a class="cta" href="#contact">Work with me</a>
      </p>

      <p class="cl-cta w-only-clean">
        <a class="cl-btn" href="#case">See what I’ve built</a>
        <a class="cl-btn ghost" href="#contact">Work with me</a>
        {cv && <a class="cl-btn ghost" href={cv.href} download>Download CV</a>}
      </p>
    </div>

    <div class="cl-links w-only-clean">
      {github && (
        <a class="cl-lc" href={github.href} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5" /></svg>
          <span><b>{github.label}</b><em>{github.text}</em></span>
        </a>
      )}
      {linkedin && (
        <a class="cl-lc" href={linkedin.href} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 11v5M8 8v.01M12 16v-5M12 13c0-1.5 1-2 2-2s2 .8 2 2v3" /></svg>
          <span><b>{linkedin.label}</b><em>{linkedin.text}</em></span>
        </a>
      )}
      {email && (
        <a class="cl-lc" href={email.href}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
          <span><b>{email.label}</b><em>{email.text}</em></span>
        </a>
      )}
    </div>
  </div>
</header>

<style>
  /* Watcher hero */
  .hero {
    position: relative;
    min-height: calc(100svh - 64px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-bottom: 110px;
    background: radial-gradient(ellipse at 75% 45%, var(--deco-hero-glow) 0, var(--deco-hero-mid) 45%, var(--color-bg) 75%);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, .2) 0 1px, transparent 1px 3px);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse at 72% 50%, transparent 38%, rgba(0, 0, 0, .6) 100%);
  }
  @media (min-width: 861px) {
    .hero { min-height: calc(100svh - 64px + 110px); }
  }
  .logs {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    font: 400 .72rem/1.9 var(--font-mono);
    color: rgba(225, 6, 0, .16);
    overflow: hidden;
    user-select: none;
    pointer-events: none;
  }
  .lr {
    white-space: nowrap;
    width: max-content;
    animation: lrs linear infinite;
  }
  @keyframes lrs { to { transform: translateX(-50%); } }

  #heye {
    position: absolute;
    right: -8%;
    top: 50%;
    width: min(70vw, 780px);
    transform: translateY(-50%);
    opacity: .95;
    pointer-events: none;
  }
  @media (min-width: 861px) {
    #heye { right: -1%; top: 45.5%; width: min(54vw, 112vh); }
  }
  #heye :global(#piv) { transition: transform .14s ease-out; }
  #heye :global(#ball), #heye :global(#sun) { will-change: transform; }

  .live {
    position: absolute;
    right: 24px;
    top: 14px;
    z-index: 3;
    font: 400 .84rem var(--font-mono);
    color: var(--color-danger);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 48px 24px;
  }
  @media (min-width: 861px) {
    .hero-inner { max-width: none; padding-left: 38px; }
  }
  @media (min-width: 1100px) {
    .hero-inner { padding-left: 54px; }
  }

  .hero-h1 { margin: 0; }
  .w-name {
    display: block;
    font: 900 clamp(3.2rem, 12.5vw, 10rem)/.88 var(--font-display);
    margin: 0 0 32px;
    letter-spacing: -.04em;
    position: relative;
  }
  @media (min-width: 861px) {
    .w-name { font-size: clamp(3.2rem, 9.5vw, 10rem); }
  }
  @media (min-width: 1100px) {
    .w-name { font-size: clamp(3.2rem, 9.2vw, 11rem); }
  }
  .w-name span {
    display: block;
    position: relative;
    text-shadow: 5px 4px 0 var(--color-accent), 0 0 36px rgba(0, 0, 0, .6);
  }
  .lead {
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    max-width: 19em;
    margin: 0 0 8px;
  }
  @media (min-width: 1100px) {
    .lead { font-size: clamp(1.5rem, 1.9vw, 2.2rem); }
  }
  .sub {
    color: var(--color-muted);
    margin: 0 0 20px;
    max-width: 42em;
  }
  .mono-line {
    font: 400 .84rem var(--font-mono);
    color: var(--color-danger);
    margin: 0 0 20px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    margin: 0;
  }
  .links a {
    text-decoration-color: var(--color-accent);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    height: 42px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    text-decoration: none;
    font: 600 .72rem var(--font-display);
    letter-spacing: .01em;
  }
  .cta:hover { background: #ff2a22; }

  @media (max-width: 860px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      min-height: 0;
      padding-top: 4px;
      padding-bottom: 48px;
    }
    #heye {
      position: relative;
      right: auto;
      top: auto;
      width: min(84vw, 400px);
      margin: 6px auto 0;
      transform: none !important;
      opacity: 1 !important;
    }
    .hero-inner {
      background: linear-gradient(180deg, transparent, rgba(6, 3, 3, .85) 16%);
      padding-top: 12px;
    }
    .live { display: none; }
  }

  /* Clean view hero (2-column editorial) */
  :global(html[data-mode='clean']) .hero {
    min-height: 0;
    display: block;
    padding: 0;
    background: var(--color-bg);
  }
  :global(html[data-mode='clean']) .hero::before,
  :global(html[data-mode='clean']) .hero::after {
    display: none;
  }
  :global(html[data-mode='clean']) .hero-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 96px 24px 64px;
    background: none;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr);
    gap: 64px;
    align-items: center;
    text-align: left;
  }
  .cl-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-line);
    background: #fff;
    border-radius: 999px;
    padding: 5px 12px;
    font: 500 12px/1.5 var(--font-body);
    color: #18181B;
    margin: 0 0 22px;
  }
  .cl-badge i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #B3261E;
  }
  .cl-h1 {
    display: block;
    font: 600 clamp(38px, 4.7vw, 64px)/1.08 var(--font-serif);
    letter-spacing: -.02em;
    color: #18181B;
    margin: 0 0 22px;
    max-width: 13em;
  }
  :global(html[data-mode='clean']) .sub {
    font: 400 18px/1.6 var(--font-body);
    color: #52525B;
    max-width: 30em;
    margin: 0 0 28px;
  }
  .cl-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
  }
  .cl-btn {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 12px 22px;
    font: 600 14px/1.2 var(--font-body);
    text-decoration: none;
    border: 1px solid #18181B;
    background: #18181B;
    color: #FCFBF9;
  }
  .cl-btn:hover { background: #3f3f46; border-color: #3f3f46; }
  .cl-btn.ghost {
    background: #FCFBF9;
    color: #52525B;
    border-color: var(--color-line);
    font-weight: 500;
  }
  .cl-btn.ghost:hover { border-color: #18181B; color: #18181B; }

  .cl-links {
    display: grid;
    gap: 12px;
    max-width: 420px;
    width: 100%;
    justify-self: end;
  }
  .cl-lc {
    display: flex;
    align-items: center;
    gap: 16px;
    background: #fff;
    border: 1px solid #E4E1DA;
    border-radius: 14px;
    padding: 16px 20px;
    color: #18181B;
    text-decoration: none;
    font: 400 15px/1.4 var(--font-body);
  }
  .cl-lc:hover { border-color: #18181B; }
  .cl-lc svg {
    width: 20px;
    height: 20px;
    flex: none;
    fill: none;
    stroke: #18181B;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cl-lc span { display: grid; gap: 2px; }
  .cl-lc b { font-weight: 500; }
  .cl-lc em {
    font: 400 12.5px/1.4 var(--font-mono);
    color: #52525B;
    font-style: normal;
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    :global(html[data-mode='clean']) .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding-top: 64px;
      padding-bottom: 48px;
    }
    .cl-links { justify-self: stretch; max-width: none; }
  }
</style>
