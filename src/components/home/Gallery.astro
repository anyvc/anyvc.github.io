---
import gallery from '../../data/gallery.json';
const items = gallery.filter(g => !('hidden' in g && g.hidden));
const url = (s: string) => (s.startsWith('/') || s.startsWith('http') ? s : '/' + s);
const cats = [
  ['all', 'All'],
  ['lab', 'Lab & Telemetry'],
  ['events', 'Events & Certifications'],
];
---
<section id="gallery" class="w-sec" aria-labelledby="gal-h">
  <div class="w-wrap">
    <h2 id="gal-h">
      <span class="w-only-watcher">EVIDENCE LOG // VISUAL ARTIFACTS</span>
      <span class="w-only-clean">Lab Evidence &amp; Credentials</span>
    </h2>

    <div class="flt" id="gflt" role="group" aria-label="Filter evidence" data-gal-filters>
      {cats.map(([k, l], i) => (
        <button type="button" data-c={k} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>
      ))}
    </div>
    <p class="w-sr" role="status" aria-live="polite" data-gal-status></p>

    <div class="ggrid" id="ggrid" data-gal-grid>
      {items.map((g, i) => {
        const num = String(i + 1).padStart(2, '0');
        const imgUrl = g.src ? url(g.src) : '';
        return (
          <button
            type="button"
            class="gi"
            data-n={i}
            data-cat={g.cat}
            data-src={imgUrl}
            data-tag={g.tag}
            data-cap={g.caption}
            data-alt={g.alt}
            aria-haspopup="dialog"
          >
            <span class="gex">EXHIBIT-{num}</span>
            <span class="gimg">
              {imgUrl ? (
                <img src={imgUrl} alt={g.alt} loading="lazy" decoding="async" />
              ) : (
                <span class="gph" role="img" aria-label={g.caption}>IMAGE SLOT</span>
              )}
              <span class="gbd">{g.tag}</span>
            </span>
            <span class="gcp" title={g.caption}>{g.caption}</span>
          </button>
        );
      })}
    </div>
    <button type="button" class="gmore" id="gmore" data-gal-more hidden>Show more</button>
  </div>

  <div id="lb" hidden role="dialog" aria-modal="true" aria-label="Evidence viewer">
    <div class="lbc">
      <button type="button" class="lbx" data-x aria-label="Close viewer">✕</button>
      <div class="lbf"></div>
      <p class="lbp"></p>
      <div class="lbn">
        <button type="button" data-d="-1">← Prev</button>
        <span class="lbk"></span>
        <button type="button" data-d="1">Next →</button>
      </div>
    </div>
  </div>
</section>

<script>import '../../scripts/gallery';</script>

<style>
  .flt {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 22px;
  }
  .flt button {
    font: 400 .75rem var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    background: none;
    color: var(--color-text);
    border: 1px solid var(--color-line);
    padding: 8px 14px;
    cursor: pointer;
  }
  .flt button:hover { border-color: var(--color-accent); }
  .flt button[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .ggrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 700px) { .ggrid { grid-template-columns: 1fr; } }

  .gi {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
    font: inherit;
    color: var(--color-text);
    cursor: pointer;
    padding: 10px 10px 12px;
    border: 1px solid rgba(225, 6, 0, .45);
    border-radius: 2px;
    background: rgba(30, 0, 0, .35);
    transition: transform .18s, box-shadow .18s, border-color .18s;
  }
  .gi:hover,
  .gi:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 rgba(225, 6, 0, .4);
    border-color: var(--color-accent);
  }
  .gex {
    display: block;
    font: 400 .68rem var(--font-mono);
    letter-spacing: .18em;
    color: var(--color-danger);
  }
  .gimg {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #120404;
    width: 100%;
  }
  .gimg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.35) brightness(.9);
  }
  .gph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 400 .7rem var(--font-mono);
    letter-spacing: .14em;
    color: var(--color-muted);
    background: repeating-linear-gradient(135deg, #1a0505 0 8px, #120404 8px 16px);
  }
  .gbd {
    position: absolute;
    left: 8px;
    top: 8px;
    font: 400 .62rem var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
    background: #050202;
    color: var(--color-text);
    border: 1px solid var(--color-accent);
    padding: 2px 7px;
  }
  .gcp {
    display: block;
    width: 100%;
    font: 400 .78rem var(--font-mono);
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gmore {
    display: block;
    margin: 22px auto 0;
    font: 400 .78rem var(--font-mono);
    letter-spacing: .06em;
    color: var(--color-text);
    background: none;
    border: 1px solid var(--color-accent);
    padding: 10px 18px;
    cursor: pointer;
  }
  .gmore:hover { background: var(--color-accent); color: #fff; }

  /* Lightbox */
  #lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: calc(20px + env(safe-area-inset-top, 0px)) 20px calc(20px + env(safe-area-inset-bottom, 0px));
    background: rgba(0, 0, 0, .86);
  }
  .lbc {
    position: relative;
    width: min(980px, 100%);
    max-height: 100%;
    overflow: auto;
    border: 1px solid var(--color-accent);
    background: #0a0404;
    padding: 14px;
  }
  .lbc :global(.lbi) {
    display: block;
    max-width: 100%;
    max-height: 68vh;
    margin: 0 auto;
    object-fit: contain;
  }
  .lbc :global(.lbm) {
    position: relative;
    aspect-ratio: 16 / 10;
  }
  .lbc :global(.lbm .gph) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 400 .78rem var(--font-mono);
    letter-spacing: .14em;
    color: var(--color-muted);
    background: repeating-linear-gradient(135deg, #1a0505 0 8px, #120404 8px 16px);
  }
  .lbp {
    margin: 12px 0 0;
    font: 400 .8rem/1.4 var(--font-mono);
    color: var(--color-muted);
  }
  .lbp :global(b) { color: var(--color-danger); font-weight: 400; letter-spacing: .14em; }
  .lbn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    font: 400 .72rem var(--font-mono);
    color: var(--color-muted);
  }
  .lbn button,
  .lbx {
    font: 400 .75rem var(--font-mono);
    color: var(--color-text);
    background: none;
    border: 1px solid var(--color-accent);
    padding: 8px 12px;
    cursor: pointer;
  }
  .lbn button:hover,
  .lbx:hover { background: var(--color-accent); color: #fff; }
  .lbx {
    position: absolute;
    right: 14px;
    top: 14px;
    z-index: 2;
    width: 38px;
    height: 38px;
    padding: 0;
    background: #0a0404;
  }

  /* Clean view */
  :global(html[data-mode='clean']) .flt button {
    border-radius: 8px;
    border-color: var(--color-line);
    background: #fff;
    color: var(--color-text);
    text-transform: none;
    letter-spacing: 0;
    font: 600 .8rem var(--font-body);
  }
  :global(html[data-mode='clean']) .flt button[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
  :global(html[data-mode='clean']) .gi {
    padding: 0;
    gap: 0;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: none;
  }
  :global(html[data-mode='clean']) .gi:hover,
  :global(html[data-mode='clean']) .gi:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 8px 24px rgba(15, 23, 42, .08);
  }
  :global(html[data-mode='clean']) .gex { display: none; }
  :global(html[data-mode='clean']) .gimg img { filter: none; }
  :global(html[data-mode='clean']) .gph,
  :global(html[data-mode='clean']) .lbc :global(.lbm .gph) {
    background: linear-gradient(135deg, #EFEDE6, #E8EEFC);
    color: var(--color-muted);
    font-family: var(--font-mono);
    letter-spacing: .04em;
  }
  :global(html[data-mode='clean']) .gbd {
    background: #E8EEFC;
    color: var(--color-accent);
    border: 1px solid #C9D6F7;
    border-radius: 999px;
    font: 500 11px var(--font-mono);
    letter-spacing: .02em;
    text-transform: none;
  }
  :global(html[data-mode='clean']) .gi[data-cat='events'] .gbd {
    background: #FBF3D5;
    color: #7A5B00;
    border-color: #EBD98E;
  }
  :global(html[data-mode='clean']) .gcp {
    padding: 12px 14px 14px;
    font: 500 .85rem var(--font-body);
    color: var(--color-text);
  }
  :global(html[data-mode='clean']) .gmore {
    border-color: var(--color-line);
    background: #fff;
    color: var(--color-text);
    border-radius: 8px;
    font: 600 .82rem var(--font-body);
  }
  :global(html[data-mode='clean']) .gmore:hover { background: #EFEDE6; color: var(--color-text); }
  :global(html[data-mode='clean']) .lbc {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 8px;
  }
  :global(html[data-mode='clean']) .lbp { color: var(--color-muted); font-family: var(--font-body); }
  :global(html[data-mode='clean']) .lbp :global(b) { color: var(--color-text); font-weight: 700; }
  :global(html[data-mode='clean']) .lbn { font-family: var(--font-body); }
  :global(html[data-mode='clean']) .lbn button,
  :global(html[data-mode='clean']) .lbx {
    font-family: var(--font-body);
    color: var(--color-text);
    background: #fff;
    border-color: var(--color-line);
    border-radius: 999px;
  }
  :global(html[data-mode='clean']) .lbx { border-radius: 50%; }
  :global(html[data-mode='clean']) .lbn button:hover,
  :global(html[data-mode='clean']) .lbx:hover { background: #EFEDE6; color: var(--color-text); }
</style>
