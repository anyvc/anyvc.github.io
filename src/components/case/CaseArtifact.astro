---
const { artifact, signal } = Astro.props;
---
<figure class="art">
  <figcaption><span>{artifact.type}</span><button type="button" data-copy>Copy</button></figcaption>
  <pre tabindex="0"><code>{artifact.code}</code></pre>
</figure>
{signal && <p class="kv">Log signal: {signal}</p>}
<script>import '../../scripts/copy';</script>
<style>
  .art { margin: 1.25rem 0 .75rem; border: 1px solid var(--color-line); border-radius: var(--shape-radius); background: var(--color-surface); }
  figcaption { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .5rem .75rem; border-bottom: 1px solid var(--color-line); font: 500 .75rem/1.3 var(--font-mono); color: var(--color-muted); }
  button { font: 500 .75rem/1 var(--font-mono); padding: .45rem .7rem; cursor: pointer; color: var(--color-text); background: transparent; border: 1px solid var(--color-border); border-radius: var(--shape-radius); }
  button:hover { border-color: var(--color-accent-text); color: var(--color-accent-text); }
  :global(html:not(.js)) button { display: none; }
  pre { margin: 0; padding: .9rem .75rem; overflow-x: auto; font: 400 .82rem/1.55 var(--font-mono); }
  .kv { font: 400 .82rem/1.5 var(--font-mono); color: var(--color-muted); }
</style>
