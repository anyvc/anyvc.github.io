---
const { artifact, signal } = Astro.props;
---
<figure class="cf-ev">
  <figcaption>
    <span class="mo">{artifact.type}</span>
    <button type="button" data-copy>Copy</button>
  </figcaption>
  <pre tabindex="0"><code>{artifact.code}</code></pre>
</figure>
{signal && <p class="cf-kv">Log signal: {signal}</p>}
<script>import '../../scripts/copy';</script>

<style>
  .cf-ev {
    margin: 18px 0 12px;
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    background: #0a0404;
    max-width: 760px;
    overflow: hidden;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--color-line);
    font: 400 12px var(--font-mono);
    color: var(--color-muted);
  }
  button {
    font: 400 .72rem var(--font-mono);
    border: 1px solid var(--color-accent);
    background: none;
    color: var(--color-text);
    padding: 4px 10px;
    cursor: pointer;
  }
  button:hover { background: var(--color-accent); color: #fff; }
  :global(html:not(.js)) button { display: none; }
  pre {
    margin: 0;
    padding: 14px;
    overflow-x: auto;
    font: 400 12.5px/1.6 var(--font-mono);
    color: var(--color-text);
    tab-size: 2;
  }
  .cf-kv { font: 400 13px/1.6 var(--font-mono); color: var(--color-muted); margin: 0 0 8px; }

  /* Clean view */
  :global(html[data-mode='clean']) .cf-ev {
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: #fff;
  }
  :global(html[data-mode='clean']) figcaption { border-bottom-color: var(--color-line); }
  :global(html[data-mode='clean']) button {
    font: 500 12px var(--font-body);
    border: 1px solid var(--color-line);
    background: #fff;
    border-radius: 999px;
    color: var(--color-text);
  }
  :global(html[data-mode='clean']) button:hover { border-color: var(--color-text); background: #EFEDE6; color: var(--color-text); }
  :global(html[data-mode='clean']) pre { color: #27272A; }
</style>
