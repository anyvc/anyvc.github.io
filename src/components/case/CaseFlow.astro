---
const { diagram: d } = Astro.props;
---
<p class="cf-cap">{d.label}</p>
<ol class="cf-chain">
  {d.nodes.map((n: { title: string; sub?: string }) => (
    <li>
      <b>{n.title}</b>{n.sub && <> <span>{n.sub}</span></>}
    </li>
  ))}
</ol>

<style>
  .cf-cap {
    font: 400 12px/1.5 var(--font-mono);
    color: var(--color-muted);
    margin: 20px 0 10px;
  }
  ol.cf-chain {
    list-style: none;
    counter-reset: c;
    margin: 0 0 20px 11px;
    padding: 0;
    max-width: 640px;
    border-left: 1px solid rgba(225, 6, 0, .4);
  }
  ol.cf-chain li {
    counter-increment: c;
    position: relative;
    padding: 0 0 14px 24px;
    color: var(--color-text);
    margin: 0;
  }
  ol.cf-chain li::before {
    content: counter(c);
    position: absolute;
    left: -11px;
    top: 1px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1px solid var(--color-accent);
    font: 500 11px/20px var(--font-mono);
    text-align: center;
    color: var(--color-accent);
  }
  ol.cf-chain li b { font-weight: 600; }
  ol.cf-chain li span { color: var(--color-muted); font-size: 14px; }

  /* Clean view */
  :global(html[data-mode='clean']) ol.cf-chain { border-left-color: var(--color-line); }
  :global(html[data-mode='clean']) ol.cf-chain li::before {
    background: #fff;
    border-color: var(--color-line);
    color: var(--color-muted);
  }
</style>
