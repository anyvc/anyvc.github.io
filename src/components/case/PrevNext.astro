---
const { prev, next } = Astro.props;
---
<nav class="cf-pn" aria-label="More case files">
  {prev ? <a href={`/case/${prev.id}/`}>← Previous: {prev.data.title}</a> : <span></span>}
  {next ? <a class="r" href={`/case/${next.id}/`}>Next: {next.data.title} →</a> : <span></span>}
</nav>

<style>
  .cf-pn {
    margin-top: 64px;
    border-top: 1px solid var(--color-line);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cf-pn a {
    font-weight: 600;
    text-decoration: none;
    color: var(--color-warn);
  }
  .cf-pn a:hover { color: var(--color-text); }
  .r { margin-left: auto; text-align: right; }

  :global(html[data-mode='clean']) .cf-pn a { color: var(--color-accent); }
  :global(html[data-mode='clean']) .cf-pn a:hover { color: #1E40AF; }
  @media (max-width: 640px) { .cf-pn { flex-direction: column; } }
</style>
