---
const { prev, next } = Astro.props;
---
<nav class="pn" aria-label="More case files">
  {prev ? <a href={`/case/${prev.id}/`}>← Previous: {prev.data.title}</a> : <span></span>}
  {next ? <a class="r" href={`/case/${next.id}/`}>Next: {next.data.title} →</a> : <span></span>}
</nav>
<style>
  .pn { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-block: 2rem 4rem; border-top: 1px solid var(--color-line); font: 500 .9rem/1.4 var(--font-mono); }
  .pn a { padding-block: .4rem; }
  .r { margin-left: auto; text-align: right; }
</style>
