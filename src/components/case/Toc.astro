---
const { items } = Astro.props;
---
<nav class="toc" aria-label="On this page" data-toc>
  <p class="toch">On this page</p>
  <ol>
    {items.map((it: { id: string; t: string }, i: number) => (
      <li><a href={`#${it.id}`}><span class="n w-only-watcher">{String(i + 1).padStart(2, '0')} //</span> <span class="t">{it.t}</span></a></li>
    ))}
  </ol>
</nav>
<script>import '../../scripts/toc';</script>
<style>
  .toch { font: 500 .75rem/1 var(--font-mono); color: var(--color-muted); margin-bottom: .75rem; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem 1rem; }
  a { padding-block: .25rem; display: inline-block; font: 400 .85rem/1.4 var(--font-mono); color: var(--color-muted); text-decoration: none; }
  a:hover, a[aria-current='true'] { color: var(--color-accent-text); }
  .n { color: var(--color-accent-text); }
  :global(html[data-mode='watcher']) .t { text-transform: uppercase; letter-spacing: .04em; }
  @media (min-width: 60rem) { ol { flex-direction: column; gap: .55rem; } }
</style>
