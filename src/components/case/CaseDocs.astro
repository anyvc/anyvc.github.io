---
import site from '../../data/site.json';
import Redact from '../site/Redact.astro';
const { docs } = Astro.props;
const w = site.caseIntro.withheld;
---
<section class="sec" id="sec-docs" data-sec aria-labelledby="h-docs">
  <h2 id="h-docs">Documents</h2>
  <ul>
    {docs.map((d: { label: string; href: string | null }) => (
      <li><span>{d.label}</span>{d.href
        ? <a href={d.href} target="_blank" rel="noopener" aria-label={`Open ${d.label}`}>Open</a>
        : <span class="soon">Coming soon</span>}</li>
    ))}
  </ul>
</section>
<style>
  .sec { margin-bottom: 2.5rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 0; border-bottom: 1px dashed var(--color-line); font-family: var(--font-mono); font-size: .9rem; }
  .soon { color: var(--color-muted); }
</style>
