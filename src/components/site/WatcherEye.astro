---
// Decorative eye. All eyes on the site use this markup and the single engine in scripts/eyes.ts.
// variant: hero | small (tracks the cursor) | outro (tracks, and closes at the end of the page)
const { variant = 'small', uid } = Astro.props;
const range = variant === 'hero' ? 62 : 14; // max pupil travel in viewBox units
const E = 'M-190 0Q0-150 190 0Q0 150-190 0Z';
---
<svg class={`weye ${variant}`} data-eye={variant} data-range={range} viewBox="-200 -110 400 220" aria-hidden="true" focusable="false">
  <defs><clipPath id={`ec-${uid}`}><path d={E} /></clipPath></defs>
  <path d={E} fill="var(--status-eye-fill)" />
  <g clip-path={`url(#ec-${uid})`}>
    <g data-eye-ball>
      <circle r="72" fill="var(--color-accent)" />
      <circle r="31" fill="var(--color-bg)" />
      <circle cx="-22" cy="-24" r="9" fill="var(--color-text)" />
    </g>
    {variant === 'outro' && <path class="lid" d={E} fill="var(--color-surface)" />}
  </g>
  <path d={E} fill="none" stroke="var(--color-accent)" stroke-width="7" stroke-linejoin="round" />
  {variant === 'outro' && <path class="seam" d="M-190 0Q0 34 190 0" fill="none" stroke="var(--color-accent)" stroke-width="7" stroke-linecap="round" />}
</svg>
<style>
  .weye { display: block; width: 100%; height: auto; overflow: visible; }
  .lid { transform-box: fill-box; transform-origin: top; transform: scaleY(0); transition: transform .5s ease-in; }
  .seam { opacity: 0; transition: opacity .2s .35s; }
  .weye[data-closed] .lid { transform: scaleY(1.02); }
  .weye[data-closed] .seam { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .lid, .seam { transition: none; } }
</style>
