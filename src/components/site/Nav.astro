---
import site from '../../data/site.json';
import ModeToggle from './ModeToggle.astro';
const { home = true } = Astro.props;
const href = (h: string) => (home ? h : '/' + h);
---
<nav class="site-nav w-noprint" aria-label="Primary">
  <div class="nav-wrap">
    <a class="logo" href={home ? '#top' : '/'} aria-label={site.name + ', home'}>{site.name}</a>
    <ul class="nav-links">
      {site.nav.map(l => (
        <li><a href={href(l.href)}>{l.label}</a></li>
      ))}
    </ul>
    <ModeToggle />
  </div>
  <i id="pg" data-nav-progress aria-hidden="true"></i>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: calc(10px + env(safe-area-inset-top, 0px));
    z-index: 40;
    margin: 10px 14px 0;
    background: rgba(6, 3, 3, .88);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    overflow: visible;
  }
  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media (min-width: 1100px) {
    .nav-wrap { max-width: none; padding: 0 40px; }
  }
  .logo {
    font: 900 .85rem var(--font-display);
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }
  .nav-links {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 1rem;
  }
  .nav-links a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .nav-links a[aria-current],
  .nav-links a:hover {
    color: var(--color-danger);
  }
  #pg {
    position: absolute;
    left: 28px;
    bottom: -1px;
    height: 2px;
    width: calc(100% - 56px);
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }

  /* Clean view */
  :global(html[data-mode='clean']) .site-nav {
    background: rgba(246, 245, 240, .94);
    border: 1px solid var(--color-line);
  }
  :global(html[data-mode='clean']) .nav-wrap {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  :global(html[data-mode='clean']) .logo {
    grid-column: 1;
    justify-self: start;
    font-weight: 700;
  }
  :global(html[data-mode='clean']) .nav-links {
    grid-column: 2;
    justify-content: center;
    font-size: .95rem;
  }
  :global(html[data-mode='clean']) .nav-links a {
    text-decoration-color: var(--color-line);
  }
  :global(html[data-mode='clean']) .nav-links a:hover,
  :global(html[data-mode='clean']) .nav-links a[aria-current] {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }
  :global(html[data-mode='clean']) #pg {
    background: var(--color-line);
  }

  @media (max-width: 860px) {
    .nav-links { display: none; }
    :global(html[data-mode='clean']) .nav-wrap {
      display: flex;
      justify-content: space-between;
    }
  }
  @media (max-width: 520px) {
    .nav-wrap { padding: 0 16px; }
    .logo { font-size: .78rem; }
  }
</style>
