---
import site from '../../data/site.json';
---
<button
  type="button"
  id="clean"
  class="mode-toggle w-noprint"
  data-mode-toggle
  data-tip-clean={site.modeLabels.toCleanTip}
  data-tip-watcher={site.modeLabels.toWatcherTip}
  data-tip={site.modeLabels.toCleanTip}
  aria-pressed="false"
>
  <span class="w-only-watcher">{site.modeLabels.toClean}</span>
  <span class="w-only-clean">{site.modeLabels.toWatcher}</span>
</button>

<style>
  .mode-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 42px;
    padding: 0 22px;
    border-radius: 999px;
    font: 600 .72rem var(--font-display);
    letter-spacing: .01em;
    background: none;
    color: var(--color-text);
    border: 1px solid var(--color-accent);
    cursor: pointer;
    white-space: nowrap;
  }
  .mode-toggle:hover {
    background: var(--color-accent);
    color: #fff;
  }
  .mode-toggle::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 250px;
    padding: 10px 12px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: #0b0202;
    color: var(--color-text);
    font: 400 .76rem/1.4 var(--font-mono);
    letter-spacing: 0;
    text-align: left;
    white-space: normal;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s;
    z-index: 5;
  }
  .mode-toggle:hover::after,
  .mode-toggle:focus-visible::after { opacity: 1; }

  /* Clean view */
  :global(html[data-mode='clean']) .mode-toggle {
    grid-column: 3;
    justify-self: end;
    gap: 10px;
    background: #fff;
    color: var(--color-text);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    font: 600 .78rem var(--font-body);
  }
  :global(html[data-mode='clean']) .mode-toggle:hover {
    background: #EFEDE6;
    color: var(--color-text);
    border-color: var(--color-line);
  }
  :global(html[data-mode='clean']) .mode-toggle::before {
    content: '';
    display: inline-block;
    width: 26px;
    height: 14px;
    border-radius: 999px;
    background: radial-gradient(circle at 70% 50%, #fff 4.5px, transparent 5px), #1C1B18;
  }
  :global(html[data-mode='clean']) .mode-toggle::after { display: none; }
  :global(html:not(.js)) .mode-toggle { display: none; }

  @media (max-width: 520px) {
    .mode-toggle { padding: 0 14px; font-size: .68rem; gap: 8px; }
  }
</style>
