{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "external_directory": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "skill": {
      "*": "deny",
      "frontend-design": "allow",
      "astro-framework": "allow"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "rm *": "deny",
      "del *": "deny",
      "rmdir *": "deny",
      "Remove-Item *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "Invoke-WebRequest *": "deny",
      "Invoke-RestMethod *": "deny",
      "iwr *": "deny",
      "irm *": "deny",
      "npx *": "deny",
      "git push *": "deny",
      "git remote *": "deny"
    }
  }
}