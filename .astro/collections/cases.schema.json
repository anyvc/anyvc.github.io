{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order": {
      "type": "number"
    },
    "cat": {
      "type": "string"
    },
    "group": {
      "type": "string",
      "enum": [
        "Defense",
        "Offense",
        "Research"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "string"
    },
    "card": {
      "type": "object",
      "properties": {
        "n": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      },
      "required": [
        "n",
        "caption"
      ]
    },
    "kpis": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "n",
          "label"
        ]
      }
    },
    "credit": {
      "type": "string"
    },
    "sections": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "did": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "docs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "label",
          "href"
        ]
      }
    },
    "signal": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code"
      ]
    },
    "diagram": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "sub": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ]
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hot": {
          "type": "number"
        }
      },
      "required": [
        "label",
        "nodes"
      ]
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "width": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "width"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "order",
    "cat",
    "group",
    "title",
    "summary",
    "tags",
    "meta",
    "card",
    "kpis",
    "sections"
  ]
}